{
  "name": "synapse-shift",
  "version": "1.0.0",
  "description": "برشِ سبک‌شده‌ی سیناپس — فقط پرسنل و برنامه‌ی ماهانه‌ی شیفت",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "init-db": "node database/migrate-sqlite.js && node database/seed.js && node database/migrate-multi-tenant.js && node database/migrate-roles.js",
    "seed-platform-settings": "node database/seed-platform-settings.js",
    "seed-nursing-hierarchy": "node database/seed-nursing-hierarchy.js",
    "seed-shift-schedule": "node database/seed-shift-schedule.js",
    "seed-shift-sample": "node database/seed-shift-sample.js",
    "import-personnel": "node database/import-personnel.js",
    "deploy:cf": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/deploy-cf.ps1",
    "deploy:cf:dry": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/deploy-cf.ps1 -DryRun",
    "dev:cf": "node cloudflare/dev-server.mjs 8787",
    "test:cf": "node cloudflare/dev-harness.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
